# Copy this to .env and fill in your keys

# ── AI Providers ──────────────────────────────────────────────────────────────
# Failover order: Groq (primary) → Gemini (fallback)
# Set PROVIDER_ORDER to change: e.g. "gemini,groq"
GROQ_API_KEY=gsk_...           # get free key at console.groq.com
GEMINI_API_KEY=AIzaSy...       # get key at aistudio.google.com
OPENAI_API_KEY=sk-...          # optional — only if OpenAI is in PROVIDER_ORDER
PROVIDER_ORDER=groq,gemini     # comma-separated, controls failover priority

# ── Other AI / Media ──────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_...      # optional — leave blank for gTTS fallback
HF_API_KEY=hf_...              # required for AI video clips (huggingface.co/settings/tokens)
FAL_KEY=fal_...                # fal.ai for FLUX.1-dev image generation

# ── Payments ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_CALLBACK_URL=https://yourdomain.com/payment/verify

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
DEV_MODE=true