+def test_summary_mentions_env_and_words():
+    plan = ProductionPlan.model_validate(_plan_dict())
+    text = format_summary(plan)
+    assert "Words:      10" in text
+    assert "PEXELS_API_KEY" in text
+    no_pexels = _plan_dict()
