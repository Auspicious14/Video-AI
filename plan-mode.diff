+                    {"kind": "wikimedia", "query": "cat", "duration_weight": 3},
+                ],
+            },
+            {
+                "title": "S2",
+                "narration": "seven eight nine ten",
+                "scenes": [{"kind": "pexels_video", "query": "sea"}],
+            },
+        ],
+    }
+
+
+@pytest.fixture(autouse=True)
