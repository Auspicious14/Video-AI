+def _silent_wav(path: Path, seconds: float) -> Path:
+    with wave.open(str(path), "wb") as w:
+        w.setnchannels(1)
+        w.setsampwidth(2)
+        w.setframerate(22050)
+        w.writeframes(b"\x00\x00" * int(22050 * seconds))
+    return path
+
+
+@pytest.fixture
+def isolated_outputs(tmp_path, monkeypatch):
